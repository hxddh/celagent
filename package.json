{
  "name": "celagent",
  "version": "0.3.6",
  "description": "独立开源 agent — Pi TUI + Celld/BOS RPO=0 持久化，崩溃/换机器/节点故障会话不丢",
  "type": "module",
  "bin": {
    "celagent": "./bin/celagent-tui.mjs"
  },
  "exports": {
    "./bos": "./src/bos.js",
    "./bos-tools": "./src/bos-tools.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "worker/",
    "docs/",
    "install.sh",
    "install.ps1",
    "setup.sh",
    "README.md",
    "HANDOFF.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/celagent-tui.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node bin/celagent-tui.mjs doctor",
    "list": "node bin/celagent-tui.mjs list"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "agent",
    "cli",
    "llm",
    "durable",
    "rpo0",
    "celld",
    "bos"
  ],
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "chalk": "^5.6.2"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
