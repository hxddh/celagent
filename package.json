{
  "name": "celagent",
  "version": "2.0.0",
  "description": "Durable agent computer — tmux supervisor + 增量工作区检查点 + 分段 Pi JSONL + manifest CAS + journal/lease",
  "type": "module",
  "bin": {
    "celagent": "./bin/celagent-tui.mjs"
  },
  "exports": {
    "./bos": "./src/bos.js",
    "./bos-tools": "./src/bos-tools.js",
    "./persist": "./src/persist.js",
    "./v2": "./src/v2/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "worker/",
    "docs/",
    "install.sh",
    "install.ps1",
    "setup.sh",
    "README.md",
    "HANDOFF.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/celagent-tui.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node bin/celagent-tui.mjs doctor",
    "list": "node bin/celagent-tui.mjs list",
    "run": "node bin/celagent-tui.mjs run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "agent",
    "cli",
    "llm",
    "durable",
    "execution",
    "journal",
    "lease",
    "rpo0",
    "celld",
    "bos"
  ],
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
